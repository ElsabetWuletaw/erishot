# PostgreSQL / Supabase
# For Supabase local development, sslmode=no-verify avoids local TLS certificate-chain errors.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&sslmode=no-verify"
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=no-verify"

# Admin login
ADMIN_EMAIL="admin@erishot.com"

# Generate with: npm run hash:admin-password -- your-password
# Next.js env files need bcrypt dollar signs escaped as \$.
ADMIN_PASSWORD_HASH="\$2b\$12\$replace-this-with-your-generated-hash"

# Use a long random value for signed admin cookies.
ADMIN_SESSION_SECRET="replace-this-with-a-long-random-secret"
